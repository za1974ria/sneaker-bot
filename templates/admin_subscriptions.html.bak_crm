<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <meta name="color-scheme" content="dark">
  <title>Abonnements — Admin</title>
  <style>
    :root { --bg:#0d0d0d; --card:#121212; --border:#2a2a2a; --text:#f4f4f5; --muted:#a1a1aa; --ok:#00ff88; --bad:#f87171; }
    * { box-sizing: border-box; }
    body { margin:0; font-family: ui-sans-serif, system-ui, sans-serif; background: var(--bg); color: var(--text); padding: 20px 16px 40px; }
    .wrap { max-width: 960px; margin: 0 auto; }
    h1 { font-size: 1.25rem; margin: 0 0 6px; }
    h2 { font-size: 1rem; margin: 28px 0 10px; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
    .sub { color: var(--muted); font-size: .88rem; margin: 0 0 18px; }
    table { width: 100%; border-collapse: collapse; background: var(--card); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; margin-bottom: 8px; }
    th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--border); font-size: .86rem; vertical-align: top; }
    th { color: var(--muted); text-transform: uppercase; font-size: .72rem; letter-spacing: .04em; }
    tr:last-child td { border-bottom: 0; }
    .actions { display: flex; flex-wrap: wrap; gap: 8px; }
    .btn { display: inline-block; padding: 8px 12px; border-radius: 8px; font-weight: 800; font-size: .78rem; text-decoration: none; border: none; cursor: pointer; }
    .btn-ok { background: var(--ok); color: #052818; }
    .btn-bad { background: transparent; color: var(--bad); border: 1px solid var(--bad); }
    .empty { color: var(--muted); padding: 24px; text-align: center; background: var(--card); border: 1px solid var(--border); border-radius: 12px; }
    .nav { margin-bottom: 20px; }
    .nav a { color: var(--ok); font-size: .88rem; }
    code { font-size: .8rem; background: #1a1a1a; padding: 2px 6px; border-radius: 4px; }
    .btn-delete { background: transparent; color: #f87171; border: 1px solid #f87171; }
    .btn-trial { background: #7c3aed; color: #fff; border: none; }
    .trial-form { display: flex; align-items: center; gap: 4px; }
    .trial-days { width: 60px; padding: 6px; border-radius: 6px; background: #1a1a1a; border: 1px solid #444; color: #fff; font-size: .8rem; }
    .badge { display:inline-block; padding:2px 8px; border-radius:12px; font-size:.72rem; font-weight:700; }
    .badge-trial { background:#7c3aed22; color:#a78bfa; border:1px solid #7c3aed; }
    .badge-validated { background:#00ff8822; color:#00ff88; border:1px solid #00ff88; }
    .badge-pending { background:#f59e0b22; color:#f59e0b; border:1px solid #f59e0b; }
    .badge-rejected { background:#f8717122; color:#f87171; border:1px solid #f87171; }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="nav"><a href="/comparison">← Comparateur</a></div>
    <h1>Demandes d’abonnement</h1>
    <p class="sub">Réservé aux comptes administrateur. Vérifiez le virement avant validation.</p>

    <h2>En attente</h2>
    {% if pending %}
    <table>
      <thead><tr><th>ID</th><th>Nom</th><th>Email</th><th>Canal</th><th>Plan</th><th>Réf.</th><th>Soumis</th><th></th></tr></thead>
      <tbody>
        {% for s in pending %}
        {% set c = (s.get('canal') or 'email')|string|lower %}
        <tr>
          <td><code>{{ s.get('id', '') }}</code></td>
          <td>{{ s.get('name', '') }}</td>
          <td>{{ s.get('email', '') }}</td>
          <td>
            <span style="color:#00ff88;font-size:11px">
              {% if c == 'email' %}📧{% elif c == 'whatsapp' %}📱{% else %}📧📱{% endif %}
              {{ c|upper }}
            </span>
          </td>
          <td>{{ s.get('plan', '') }}</td>
          <td>{{ s.get('reference', '') }}</td>
          <td>{{ s.get('submitted_at', '') }}</td>
          <td class="actions">
            <form method="post" action="/admin/validate/{{ s.get('id', '') }}" style="display:inline">
              <button type="submit" class="btn btn-ok">Valider</button>
            </form>
            <form method="post" action="/admin/reject/{{ s.get('id', '') }}" style="display:inline" onsubmit="return confirm('Refuser cette demande ?')">
              <button type="submit" class="btn btn-bad">Refuser</button>
            </form>
            <form method="post" action="/admin/trial/{{ s.get('id', '') }}" style="display:inline" class="trial-form" onsubmit="return confirm('Accorder un essai gratuit ?')">
              <input type="number" name="days" value="14" min="1" max="3650" class="trial-days" title="Durée (jours)">
              <button type="submit" class="btn btn-trial">🎁 Essai</button>
            </form>
            <form method="post" action="/admin/delete/{{ s.get('id', '') }}" style="display:inline" onsubmit="return confirm('Supprimer définitivement cette demande ? Cette action est irréversible.')">
              <button type="submit" class="btn btn-delete">Supprimer</button>
            </form>
            <a href="{{ s.get('wa_me_url', '#') }}"
               target="_blank" rel="noopener noreferrer"
               style="background:#25D366;color:#fff;padding:6px 12px;border-radius:6px;text-decoration:none;font-size:12px;display:inline-block">
              📱 WhatsApp
            </a>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
    <p class="empty">Aucune demande en attente.</p>
    {% endif %}

    <h2>Validés & Essais</h2>
    {% if validated %}
    <table>
      <thead><tr><th>ID</th><th>Nom</th><th>Email</th><th>Plan</th><th>Login</th><th>Validé</th><th>Expiration essai</th><th></th></tr></thead>
      <tbody>
        {% for s in validated %}
        <tr>
          <td><code>{{ s.get('id', '') }}</code></td>
          <td>{{ s.get('name', '') }}</td>
          <td>{{ s.get('email', '') }}</td>
          <td>
            {% if s.get('status') == 'trial' %}
            <span class="badge badge-trial">🎁 Essai</span>
            {% else %}
            <span class="badge badge-validated">{{ s.get('plan', '') }}</span>
            {% endif %}
          </td>
          <td><code>{{ s.get('username', '') }}</code></td>
          <td>{{ s.get('validated_at', '') }}</td>
          <td style="font-size:.8rem;color:{% if s.get('trial_end') %}#a78bfa{% else %}var(--muted){% endif %}">
            {{ s.get('trial_end', '—') }}
          </td>
          <td class="actions">
            {% if s.get('show_email_sent') %}
            <span style="background:#1a3a2a;color:#7bf1a8;padding:6px 12px;border-radius:6px;font-size:12px;display:inline-block;border:1px solid rgba(0,255,136,0.35)">📧 Email envoyé ✅</span>
            {% endif %}
            {% if s.get('wa_client_url') %}
            <a href="{{ s.get('wa_client_url') }}"
               target="_blank" rel="noopener noreferrer"
               style="background:#25D366;color:#fff;padding:6px 12px;border-radius:6px;text-decoration:none;font-size:12px;display:inline-block">
              📱 Accès WhatsApp client
            </a>
            {% endif %}
            {% if not s.get('show_email_sent') and not s.get('wa_client_url') %}
            <span style="color:var(--muted);font-size:12px">—</span>
            {% endif %}
            {% if s.get('username') %}
            <form method="post" action="/admin/reset/{{ s.get('username') | urlencode }}" style="display:inline" onsubmit="return confirm('Réinitialiser les accès ?')">
              <button type="submit" style="background:#ff8c00;color:#fff;padding:4px 10px;border-radius:4px;border:none;font-size:11px;margin-left:4px;cursor:pointer">
                🔄 Reset
              </button>
            </form>
            {% endif %}
            <form method="post" action="/admin/delete/{{ s.get('id', '') }}" style="display:inline" onsubmit="return confirm('Supprimer définitivement cet abonnement ?')">
              <button type="submit" class="btn btn-delete" style="font-size:.75rem;padding:4px 8px">Supprimer</button>
            </form>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
    <p class="empty">Aucun abonnement validé.</p>
    {% endif %}

    <h2>Refusés</h2>
    {% if rejected %}
    <table>
      <thead><tr><th>ID</th><th>Nom</th><th>Email</th><th>Plan</th><th>Refusé</th><th></th></tr></thead>
      <tbody>
        {% for s in rejected %}
        <tr>
          <td><code>{{ s.get('id', '') }}</code></td>
          <td>{{ s.get('name', '') }}</td>
          <td>{{ s.get('email', '') }}</td>
          <td>{{ s.get('plan', '') }}</td>
          <td>{{ s.get('rejected_at', '') }}</td>
          <td>
            <form method="post" action="/admin/delete/{{ s.get('id', '') }}" style="display:inline" onsubmit="return confirm('Supprimer définitivement ce refus ?')">
              <button type="submit" class="btn btn-delete" style="font-size:.75rem;padding:4px 8px">Supprimer</button>
            </form>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
    <p class="empty">Aucun refus.</p>
    {% endif %}

    <p style="color:var(--muted);font-size:.8rem;margin-top:24px">
      Prix actualisés 2 fois par jour (08h00 et 20h00) pour garantir stabilité et fiabilité.
    </p>
  </div>
</body>
</html>
