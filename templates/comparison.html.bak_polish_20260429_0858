    .sb-radar-label{color:#4a7a56;font-weight:600;flex:1}
    .sb-radar-status-dot{color:#00ff88;font-size:10px;animation:sb-radar-blink 1.4s ease-in-out infinite}
    @keyframes sb-radar-blink{0%,100%{opacity:1}50%{opacity:.2}}
    .sb-radar-status-text{color:#00ff88;font-size:10px;font-weight:800;letter-spacing:.1em}
    .sb-radar-time{color:#4a7a56;font-size:10px;margin-left:auto}
    .sb-radar-body{
      display:grid;grid-template-columns:230px 1fr 160px;
      gap:0;min-height:200px;
    }
    .sb-radar-canvas-wrap{
      position:relative;display:flex;align-items:center;justify-content:center;
      padding:16px;border-right:1px solid #132a18;
    }
    #sb-radar-canvas{display:block}
    .sb-radar-center-label{
      position:absolute;bottom:22px;left:50%;transform:translateX(-50%);
