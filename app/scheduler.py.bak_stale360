PROJECT_DIR: Final[Path] = Path(__file__).resolve().parent.parent  # /root/sneaker_bot
LOG_DIR: Final[Path] = PROJECT_DIR / "logs"
LOG_PATH: Final[Path] = LOG_DIR / "scraper.log"
