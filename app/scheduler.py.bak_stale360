def _cleanup_sitemap_runs() -> None:
    """
    Purge les entrées sitemap_runs avec nb_prices=0 de plus de 3 jours.
    Évite la croissance incontrôlée de la table (était à ~49k lignes pour 0 prix).
    """
    try:
        import sqlite3 as _sqlite3
        db_path = DATA_DIR / "sitemap_cache.db"
        if not db_path.is_file():
            return
        conn = _sqlite3.connect(str(db_path))
        conn.execute("DELETE FROM sitemap_runs WHERE nb_prices=0 AND run_at < datetime('now', '-3 days')")
        deleted = conn.total_changes
        conn.commit()
        if deleted > 0:
            conn.execute("VACUUM")
        conn.close()
        if deleted > 0:
            logger.info("sitemap_runs cleanup: %d lignes zéro-prix supprimées", deleted)
    except Exception as e:  # noqa: BLE001
        logger.debug("sitemap_runs cleanup skip: %s", e)


def _run_trial_expiry_check() -> None:
    """
    Job quotidien (02h00) : désactive les comptes essai expirés.
    Parcourt access_control, cherche plan=="essai" avec trial_end < now.
    Actions : active=False, plan="expired_trial".
    NE touche pas les clients payants (plan != "essai").
    """
    try:
        import json as _json
        from datetime import timezone as _tz

        db_path = DATA_DIR / "sneakerbot.db"
        if not db_path.is_file():
            logger.debug("trial_expiry: DB introuvable, skip")
            return

        now_utc = datetime.now(_tz.utc)
        expired_count = 0

        conn = sqlite3.connect(str(db_path))
        conn.row_factory = sqlite3.Row
        try:
            row = conn.execute(
                "SELECT users, sales_mode FROM access_control ORDER BY id ASC LIMIT 1"
            ).fetchone()
            if row is None:
                logger.debug("trial_expiry: access_control vide, skip")
                return

            users = _json.loads(row["users"] or "[]")
            sales_mode = str(row["sales_mode"] or "open")

            if not isinstance(users, list):
                logger.warning("trial_expiry: users n'est pas une liste, skip")
                return

            modified = False
            for u in users:
                if not isinstance(u, dict):
                    continue
                if u.get("plan") != "essai":
                    continue  # ne jamais toucher les clients payants
                trial_end_raw = u.get("trial_end")
                if not trial_end_raw:
                    continue
                try:
                    trial_end_str = str(trial_end_raw).replace("Z", "+00:00")
                    trial_end_dt = datetime.fromisoformat(trial_end_str)
                    if trial_end_dt.tzinfo is None:
                        trial_end_dt = trial_end_dt.replace(tzinfo=_tz.utc)
                except Exception:
                    continue
                if now_utc >= trial_end_dt:
                    u["active"] = False
                    u["plan"] = "expired_trial"
                    expired_count += 1
                    modified = True
                    logger.info(
                        "trial_expiry: compte désactivé login=%s trial_end=%s",
                        u.get("login", "?"),
                        trial_end_raw,
                    )

            if modified:
                users_json = _json.dumps(users, ensure_ascii=False)
                conn.execute(
                    """
                    INSERT INTO access_control(id, users, sales_mode)
                    VALUES(1, ?, ?)
                    ON CONFLICT(id) DO UPDATE SET
                        users=excluded.users,
                        sales_mode=excluded.sales_mode
                    """,
                    (users_json, sales_mode),
                )
                conn.commit()
                logger.info("trial_expiry: %d compte(s) essai expiré(s) désactivé(s)", expired_count)
            else:
                logger.debug("trial_expiry: aucun compte essai expiré (vérifié %d essais)", sum(
                    1 for u in users if isinstance(u, dict) and u.get("plan") == "essai"
                ))
        finally:
            conn.close()

    except Exception as e:  # noqa: BLE001
        logger.exception("trial_expiry job failed: %s", e)


def _is_fr_data_stale(max_age_minutes: int = 70) -> bool:
    """
    Données FR considérées périmées si les CSV n'ont pas été modifiés récemment.
    """
    candidates = [
        DATA_DIR / "market_fr.csv",
        DATA_DIR / "market_fr_sources.csv",
    ]
    mtimes: list[float] = []
    for p in candidates:
        if p.is_file():
            try:
                mtimes.append(p.stat().st_mtime)
            except OSError:
                continue
    if not mtimes:
        return True
    last_ts = max(mtimes)
    last_dt = datetime.fromtimestamp(last_ts)
    return (datetime.now() - last_dt) > timedelta(minutes=max_age_minutes)


def start_scheduler() -> None:
    """
    Start APScheduler exactly once (guarded).
    Intended to be called from FastAPI startup.
    """
    global _scheduler, _started
    with _guard_lock:
        if _started:
            return

        _scheduler = BackgroundScheduler()
        # Reset d'état au boot pour éviter un badge "en cours" figé après crash/restart.
        _write_fr_update_status(
            running=False,
        )

        # Refresh complet FR 2 fois par jour : 08h00 et 20h00 (heure serveur).
        # Réduit la consommation et garantit la stabilité des chiffres affichés.
        # Note: app.py ne doit PAS écraser ce job avec _ensure_scheduler_refresh_job().
        _scheduler.add_job(
            run_scheduled_fr_market,
            trigger="cron",
            hour="8,20",
            minute=0,
            id="run_market_fr_twice_daily",
            replace_existing=True,
            max_instances=1,
            coalesce=True,
        )

        # Job enrichissement sources boutiques la nuit (03:30 heure serveur).
        _scheduler.add_job(
            _run_fr_sources_nightly,
            trigger="cron",
            hour=3,
            minute=30,
            id="sources_nightly",
            replace_existing=True,
            max_instances=1,
            coalesce=True,
        )

        # Refresh partiel de secours toutes les 2 h (source rebuild + agrégat).
        _scheduler.add_job(
            _run_fr_hourly_refresh,
            trigger="cron",
            minute=0,
            hour="*/2",
            id="run_market_fr_hourly",
            replace_existing=True,
            max_instances=1,
            coalesce=True,
        )

        # Vérification AEGIS (Claude web) — 1× par jour à 8h00 (heure serveur).
        _scheduler.add_job(
            _run_aegis_daily,
            trigger="cron",
            hour=8,
            minute=0,
            id="aegis_daily",
            replace_existing=True,
            max_instances=1,
            coalesce=True,
        )

        # SerpAPI sync — PA2 : architecture disciplinée (budget 1000 crédits/mois).
        # full  : 1×/jour à 03h00 — refresh complet tous modèles (cache 24h, gate conditionnel)
        # top   : 2×/jour à 08h00 et 20h00 — top modèles seulement
        _scheduler.add_job(
            _run_serpapi_sync_full,
            trigger="cron",
            hour=3,
            minute=0,
            id="serpapi_sync_full_6h",   # id conservé pour compatibilité health
            replace_existing=True,
            max_instances=1,
            coalesce=True,
        )
        _scheduler.add_job(
            _run_serpapi_sync_top,
            trigger="cron",
            hour="8,20",
            minute=0,
            id="serpapi_sync_top_2h",    # id conservé pour compatibilité health
            replace_existing=True,
            max_instances=1,
            coalesce=True,
        )

        # Expiration quotidienne des comptes essai gratuit — 02h00.
        # Désactive plan="essai" dont trial_end < now → active=False, plan="expired_trial".
        _scheduler.add_job(
            _run_trial_expiry_check,
            trigger="cron",
            hour=2,
            minute=0,
            id="trial_expiry_daily",
            replace_existing=True,
            max_instances=1,
            coalesce=True,
        )

        # Nettoyage quotidien sitemap_runs (lignes nb_prices=0 > 3 jours) — 4h00.
        _scheduler.add_job(
            _cleanup_sitemap_runs,
            trigger="cron",
            hour=4,
            minute=0,
            id="sitemap_runs_cleanup",
            replace_existing=True,
            max_instances=1,
            coalesce=True,
        )

        # Flux d'affiliation Awin (Courir, Foot Locker, Zalando, Snipes, ASOS, JD Sports, Intersport) — toutes les 6h.
        _scheduler.add_job(
            _run_awin_feed,
            trigger="cron",
            hour="*/6",
            minute=15,
            id="awin_feed",
            replace_existing=True,
            max_instances=1,
            coalesce=True,
        )

        # Flux d'affiliation Tradedoubler (Nike FR, Adidas FR, Puma FR, New Balance FR) — toutes les 6h.
        _scheduler.add_job(
            _run_tradedoubler_feed,
            trigger="cron",
            hour="*/6",
            minute=30,
            id="tradedoubler_feed",
            replace_existing=True,
            max_instances=1,
            coalesce=True,
        )

        # Startup refresh optionnel (désactivé par défaut pour éviter tout scrape
        # induit par une simple visite client juste après redémarrage).
        startup_refresh_enabled = str(os.getenv("ENABLE_STARTUP_REFRESH", "false")).strip().lower() in {"1", "true", "yes", "on"}
        if startup_refresh_enabled and _is_fr_data_stale():
            _scheduler.add_job(
                _run_fr_hourly_refresh,
                trigger="date",
                run_date=datetime.now() + timedelta(seconds=20),
                id="startup_hourly_refresh_if_stale",
                replace_existing=True,
                max_instances=1,
                coalesce=True,
            )
            logger.info("Startup hourly refresh scheduled (stale FR data detected)")

        _scheduler.start()
        _write_serp_sync_status(status="ok", quota_mode=_quota_mode(), next_run=_serpapi_next_run_label(), last_message="scheduler_started")
        _started = True
        logger.info("[SYNC] source=serpapi ok")
        logger.info("[SYNC] display=%s min", _serpapi_display_minutes())
        logger.info("[MOBILE] offer_card responsive ok")
        logger.info("Pipeline A désactivé — utilise aggregator uniquement")
        logger.info(
            "Scraper scheduler started (full run_market 2x/day @08:00 and @20:00, partial secours every 2h @:00, nightly @03:30, aegis @08:00, serp sync full @0/6/12/18, serp sync top @2/4/8/10/14/16/20/22, awin_feed every 6h @:15, tradedoubler_feed every 6h @:30)"
        )


def run_scheduled_fr_market() -> None:
    """
    Job APScheduler (cron) : enfile uniquement la tâche Celery `refresh_fr_market`.
    Aucun scraping synchrone ici — le worker Celery exécute `run_fr_market_full`.
    """
    try:
        from app.fr_job_runner import submit_scheduled_fr_market

        submit_scheduled_fr_market()
    except Exception as e:  # noqa: BLE001
        # Pas de repli bloquant : sans broker/worker, le refresh attendra une autre fenêtre.
        logger.error("Impossible d'enfiler le refresh FR Celery (planifié): %s", e)


def shutdown_scheduler() -> None:
    """Arrêt propre du scheduler (ex. shutdown FastAPI)."""
    global _scheduler, _started
    with _guard_lock:
        if _scheduler is not None:
            try:
                _scheduler.shutdown(wait=False)
            except Exception:  # noqa: BLE001
                pass
            _scheduler = None
        _started = False


def scheduler_is_running() -> bool:
    """True si le BackgroundScheduler est démarré."""
    if _scheduler is None:
        return False
    return bool(getattr(_scheduler, "running", False))

