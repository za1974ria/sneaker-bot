<script>
/* ══ SNEAKERBOT RADAR ENGINE v1.0 ══ */
(function(){
  'use strict';
  var canvas = document.getElementById('sb-radar-canvas');
  if (!canvas) return;
  var ctx = canvas.getContext('2d');
  var W = canvas.width, H = canvas.height;
  var cx = W/2, cy = H/2, R = W/2 - 14;
  var angle = 0;
  var nodes = [
    {label:'PARIS',    a:45,  d:0.55, on:true,  home:false},
    {label:'LYON',     a:130, d:0.70, on:true,  home:false},
    {label:'BORDEAUX', a:200, d:0.65, on:true,  home:false},
    {label:'BERLIN',   a:290, d:0.80, on:false, home:false},
    {label:'AMSTERDAM',a:340, d:0.60, on:true,  home:false},
    {label:'TLEMCEN',  a:170, d:0.30, on:true,  home:true},
  ];

  function toRad(deg){ return deg * Math.PI / 180; }

  function drawFrame(){
    ctx.clearRect(0,0,W,H);
    ctx.fillStyle = '#040a06';
    ctx.fillRect(0,0,W,H);

    // Cercles concentriques
    for(var i=1; i<=4; i++){
      ctx.beginPath();
      ctx.arc(cx,cy, R*(i/4), 0, Math.PI*2);
      ctx.strokeStyle = i===4 ? '#1a4a22' : '#0d2210';
      ctx.lineWidth   = i===4 ? 1.2 : 0.6;
      ctx.stroke();
    }

    // Croix
    ctx.strokeStyle = '#0d2210'; ctx.lineWidth = 0.6;
    ctx.beginPath(); ctx.moveTo(cx,cy-R); ctx.lineTo(cx,cy+R); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(cx-R,cy); ctx.lineTo(cx+R,cy); ctx.stroke();

    // Sweep trail
    var trailLen = Math.PI/3;
    ctx.save();
    ctx.translate(cx,cy);
    for(var t=0; t<20; t++){
      var a0 = angle - (t/20)*trailLen;
      var alpha = (1 - t/20) * 0.16;
      ctx.beginPath();
      ctx.moveTo(0,0);
      ctx.arc(0,0, R, a0-0.08, a0+0.02);
      ctx.fillStyle = 'rgba(0,255,136,'+alpha+')';
      ctx.fill();
    }
    ctx.restore();

    // Sweep line
    ctx.save();
    ctx.translate(cx,cy);
    ctx.beginPath();
    ctx.moveTo(0,0);
    ctx.lineTo(Math.cos(angle)*R, Math.sin(angle)*R);
    ctx.strokeStyle = 'rgba(0,255,136,0.85)';
    ctx.lineWidth = 1.5;
    ctx.shadowColor = '#00ff88'; ctx.shadowBlur = 6;
    ctx.stroke();
    ctx.shadowBlur = 0;
    ctx.restore();

    // Nodes
    ctx.save();
    ctx.translate(cx,cy);
    nodes.forEach(function(n){
      var rad = toRad(n.a);
      var px  = Math.cos(rad)*R*n.d;
      var py  = Math.sin(rad)*R*n.d;

      // Détecter si le sweep passe sur ce nœud
      var na = rad % (Math.PI*2); if(na<0) na+=Math.PI*2;
      var sa = angle % (Math.PI*2);
      var diff = sa - na; if(diff<0) diff+=Math.PI*2;
      var glowing = diff < 0.35;

      ctx.beginPath();
      ctx.arc(px,py, n.home?4:2.5, 0, Math.PI*2);
      if(n.home){
        ctx.fillStyle = '#00ff88';
        ctx.shadowColor = '#00ff88'; ctx.shadowBlur = glowing?16:8;
      } else if(n.on){
        ctx.fillStyle = glowing ? '#00ff88' : '#4aaa6a';
        ctx.shadowColor = '#4aaa6a'; ctx.shadowBlur = glowing?10:3;
      } else {
        ctx.fillStyle = '#1a3a22'; ctx.shadowBlur = 0;
      }
      ctx.fill(); ctx.shadowBlur = 0;

      ctx.font = '7px monospace';
      ctx.fillStyle = n.home?'#00ff88':(n.on?'#4aaa6a':'#1a3a22');
      ctx.fillText(n.label, px+5, py-5);
    });
    ctx.restore();

    // Centre
    ctx.beginPath(); ctx.arc(cx,cy,3,0,Math.PI*2);
    ctx.fillStyle='#00ff88'; ctx.shadowColor='#00ff88'; ctx.shadowBlur=8;
    ctx.fill(); ctx.shadowBlur=0;

    angle += 0.018;
    if(angle > Math.PI*2) angle -= Math.PI*2;
    requestAnimationFrame(drawFrame);
  }
  drawFrame();

  // Fetch radar-status toutes les 8 s
  function fetchRadar(){
    fetch('/api/radar-status')
      .then(function(r){ return r.json(); })
      .then(function(d){
        function el(id){ return document.getElementById(id); }
        function setBar(barId, pct){
          var b=el(barId); if(b) b.style.width=Math.min(pct,100)+'%';
        }
        if(el('sb-radar-time')) el('sb-radar-time').textContent = d.timestamp||'--:--:--';

        var cpu=d.cpu||0;
        if(el('rm-cpu')) el('rm-cpu').textContent=cpu.toFixed(1)+' %';
        setBar('rm-bar-cpu', cpu);

        var ram=d.ram||0;
        if(el('rm-ram')) el('rm-ram').textContent=ram.toFixed(1)+' %';
        setBar('rm-bar-ram', ram);

        var disk=d.disk||0;
        if(el('rm-disk')) el('rm-disk').textContent=disk.toFixed(1)+' %';
        setBar('rm-bar-disk', disk);

        var sc=d.scrapers||19;
        if(el('rm-scrapers')) el('rm-scrapers').textContent=sc+' / ACTIFS';
        setBar('rm-bar-scrapers', (sc/20)*100);

        var ls=d.last_update_sec||0;
        if(el('rm-sync')){
          el('rm-sync').textContent = ls<60 ? ls+' s'
            : ls<3600 ? Math.floor(ls/60)+' min'
            : Math.floor(ls/3600)+' h';
        }
        if(el('rm-pipeline')) el('rm-pipeline').textContent=(d.pipeline||'v2')+' ✓';
        if(el('sb-radar-status-text')) el('sb-radar-status-text').textContent=d.status||'ACTIVE';

        if(d.nodes && Array.isArray(d.nodes)){
          nodes = d.nodes.map(function(n){
            return {label:n.label,a:n.angle,d:n.dist,on:n.active,home:!!n.isHome};
          });
          var nl=el('sb-radar-nodes-list');
          if(nl){
            nl.innerHTML=nodes.map(function(n){
              var dc=n.home?'sb-rn-dot sb-rn-dot-home':(n.on?'sb-rn-dot sb-rn-dot-on':'sb-rn-dot sb-rn-dot-off');
              var tc=n.home?'sb-rn-name sb-rn-home':'sb-rn-name';
              return '<div class="sb-rn-item"><span class="'+dc+'"></span><span class="'+tc+'">'+n.label+'</span></div>';
            }).join('');
          }
        }
      })
      .catch(function(){
        var s=document.getElementById('sb-radar-status-text');
        if(s){s.textContent='ERROR';s.style.color='#f87171';}
      });
  }
  fetchRadar();
  setInterval(fetchRadar,8000);
})();
/* ══ END RADAR ══ */
</script>
